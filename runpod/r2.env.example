# Copy to r2.env (same dir), fill in, never commit r2.env.
# Cloudflare dash -> R2: create bucket + "Manage R2 API Tokens" -> Object Read & Write token.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=har-results
# Optional key prefix inside the bucket
R2_PREFIX=sodium_ion_battery

# RunPod console -> Settings -> API Keys (needed for self-terminate).
RUNPOD_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# terminate = pod fully deleted (no more billing at all, volume gone)
# stop      = pod stopped, volume kept (small storage billing continues)
# none      = leave the pod running
STOP_MODE=terminate

# SSH endpoint that RunPod prints for your pod ("Connect" panel).
# Used ONLY by push.sh / pull.sh from your laptop.
RUNPOD_SSH_HOST=ssh.runpod.io
RUNPOD_SSH_PORT=22
RUNPOD_SSH_USER=root
RUNPOD_SSH_KEY=~/.ssh/id_ed25519

# --- Pod filesystem layout ---------------------------------------------------
# POD_ROOT plays the role of the local "Standard cycling" folder.
# push.sh ships:
#   code/           -> $POD_ROOT/code/
#   data statics/   -> $POD_ROOT/data statics/     (tables + parse_errors log)
# setup.sh downloads + extracts the RWTH zip into $POD_DATASET_DIR and
# auto-detects the DODxxx_*/ subtree.
POD_WORKSPACE="/workspace"
POD_ROOT="/workspace/sib"
POD_CODE_DIR="/workspace/sib/code"
# Quoted: the value contains no space in the current layout, but an unquoted
# value with one is executed as a command by `set -a; source` and kills
# setup.sh/push.sh (both use `set -e`). The directory is `data_statics`.
POD_DATA_STATICS_DIR="/workspace/sib/code/data_statics"
POD_DATASET_DIR="/workspace/sib/dataset"
# Note: setup.sh:24 overwrites this unconditionally; it is informational.
POD_RESULTS_DIR="/workspace/sib/code/artifacts"

# --- Pipeline knobs ----------------------------------------------------------
# Workers for build_features (parquet builder) and run_all_experiments
# (parallel model fits). Blank = use whatever is in config.yaml
# (experiment.parallel_workers, currently 6). Set higher on beefy pods.
SIB_PARALLEL_WORKERS=

# Which stages to run. Comma-separated, or one of the aliases below.
#
# Individual stages:
#   smoke, canonical, build, build_unified, tests, degradation, experiments,
#   aggregate, plot, pinn, pinn_seeds, pinn_smoke, pinn_aggregate,
#   pinn_ablation, pinn_plot, pinn_nested, generalization, low_data,
#   uncertainty, robustness, studies, combined_report
#
# Aliases:
#   all             legacy full classical + PINN pipeline
#   revision_smoke  tests + unified features + one short PINN fold
#   revision_dev    development-only: no holdout, no plots  (start here)
#   revision        full revision incl. seed spread and plots
#   paper           revision + the four study scripts (11-14) + ablations
#
# 'tests' gates everything after it: a wiring-test failure stops the run before
# GPU time is spent. 'build_unified' builds only cu_capacity + unified.parquet.
RUN_STAGES=revision_dev

# Primary NaPINN-Q seed — the only seed any tuning decision may use, and the
# only one that may appear as a headline number.
SIB_PRIMARY_SEED=42
# Extra seeds for the robustness spread (stage 'pinn_seeds'). Space separated.
# Reported ONLY as "spread across random initializations"; never seed-averaged
# into the headline metric, never used to select anything.
# Quoted for the same reason as the paths above.
SIB_SPREAD_SEEDS="43 44 45 46"
