# Copy to r2.env (same dir), fill in, never commit r2.env.
# Cloudflare dash -> R2: create bucket + "Manage R2 API Tokens" -> Object Read & Write token.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=har-results
# Optional key prefix inside the bucket
R2_PREFIX=sodium_ion_battery

# RunPod console -> Settings -> API Keys (needed for self-terminate).
RUNPOD_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# terminate = pod fully deleted (no more billing at all, volume gone)
# stop      = pod stopped, volume kept (small storage billing continues)
# none      = leave the pod running
STOP_MODE=terminate

# SSH endpoint that RunPod prints for your pod ("Connect" panel).
# Used ONLY by push.sh / pull.sh from your laptop.
RUNPOD_SSH_HOST=ssh.runpod.io
RUNPOD_SSH_PORT=22
RUNPOD_SSH_USER=root
RUNPOD_SSH_KEY=~/.ssh/id_ed25519

# --- Pod filesystem layout ---------------------------------------------------
# POD_ROOT plays the role of the local "Standard cycling" folder.
# push.sh ships:
#   code/           -> $POD_ROOT/code/
#   data statics/   -> $POD_ROOT/data statics/     (tables + parse_errors log)
# setup.sh downloads + extracts the RWTH zip into $POD_DATASET_DIR and
# auto-detects the DODxxx_*/ subtree.
POD_WORKSPACE=/workspace
POD_ROOT=/workspace/sib
POD_CODE_DIR=/workspace/sib/code
POD_DATA_STATICS_DIR=/workspace/sib/data statics
POD_DATASET_DIR=/workspace/sib/dataset
POD_RESULTS_DIR=/workspace/sib/code/artifacts

# --- Pipeline knobs ----------------------------------------------------------
# Workers for build_features (parquet builder) and run_all_experiments
# (parallel model fits). Blank = use whatever is in config.yaml
# (experiment.parallel_workers, currently 6). Set higher on beefy pods.
SIB_PARALLEL_WORKERS=

# Which stages to run. Comma-separated; valid names:
# canonical,build,degradation,experiments,aggregate,plot,smoke.
# Default runs the whole thing.
RUN_STAGES=canonical,build,degradation,experiments,aggregate,plot
